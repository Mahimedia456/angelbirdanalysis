{
  "expo": {
    "name": "AngelBird Reporting",
    "slug": "angelbird-reporting",
    "version": "0.13.1",
    "orientation": "portrait",
    "scheme": "angelbird-reporting",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahimediasolutions.angelbirdreporting",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ]
      }
    },
    "android": {
      "package": "com.mahimediasolutions.angelbirdreporting",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/brand/adaptive-icon-monochrome.png"
      },
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/angelbird-mark-white.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#2F3D46",
          "dark": {
            "image": "./assets/brand/angelbird-mark-white.png",
            "backgroundColor": "#2F3D46"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "dataMode": "secure-auto-sync-cache",
      "brandSource": "angelbird-favicon",
      "security": "role-allowlist",
      "charts": "native-mixed-line-donut-horizontal-bar",
      "androidSafeArea": "system-navigation-aware-tabs",
      "router": {},
      "eas": {
        "projectId": "345fab4c-d159-4ad4-abdd-a2c6b63e0e7c"
      }
    },
    "description": "Secure AngelBird mobile reporting for Ticket, Satisfaction and RMA analytics.",
    "primaryColor": "#D7FF00"
  }
}
